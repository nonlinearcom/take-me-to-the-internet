# Canonical public URL of this site (site-config: sitemap, canonicals, og tags, i18n).
# Read at runtime by nuxt-site-config, so changing it does not require a rebuild.
# Must also be present at build time: the i18n module bakes it in as the base
# of its hreflang links (see runtimeConfig.public.i18n in nuxt.config.ts).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the Directus backend. The browser fetches content from it directly;
# images go through this site's /assets/** proxy instead, so image URLs never
# carry this host. Read at runtime, so changing it does not require a rebuild.
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# Optional, server only: where the Nuxt server reaches Directus for SSR fetches
# and the /assets/** proxy. Set it to the internal Docker hostname on Coolify so
# that traffic stays on the host; falls back to NUXT_PUBLIC_DIRECTUS_URL.
# NUXT_DIRECTUS_URL=http://directus:8055
