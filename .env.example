# Canonical public URL of this site (site-config: sitemap, canonicals, og tags, i18n).
# Read at runtime by nuxt-site-config, so changing it does not require a rebuild.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the Directus backend that serves content and assets.
# Read at runtime, so changing it does not require a rebuild.
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
